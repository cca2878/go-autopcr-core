{
	"name": "Go+Rust+Python",
	"image": "mcr.microsoft.com/devcontainers/go:2-1.26-trixie",
	"features": {
		"ghcr.io/devcontainers/features/go:1": {
			"version": "1.26",
			"installGolangCI_Lint": true
		},
		"ghcr.io/devcontainers/features/rust:1": {},
		"ghcr.io/devcontainers/features/python:1": {
			"version": "3.10"
		},
		"ghcr.io/devcontainers/features/node:2.1.0": {}
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"golang.go",
				"rust-lang.rust-analyzer",
				"andaoai.yolo-labeling-vs",
				"TanvirTaaha.yolo-annotator",
				"sdmapvstool.xiaomimimo-for-copilot",
				"vscode-infra.image-viewer",
				"Vizards.deepseek-v4-for-copilot",
				"redhat.vscode-yaml",
				"GitHub.vscode-pull-request-github",
				"ms-vscode.makefile-tools",
				"anthropic.claude-code"
			],
			"settings": {
				"go.lintTool": "golangci-lint",
				"go.lintOnSave": "package",
				"editor.formatOnSave": true
			}
		}
	}
}